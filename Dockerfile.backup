# AUSTRO AI - Backup worker image (PostgreSQL 16 client)
#
# Purpose: run the automated, one-shot logical backup
# (scripts/pg_backup.py) on a UTC schedule (scripts/backup_scheduler.py) as an
# INDEPENDENT container. It is never part of the Telegram update loop.
#
# Why a dedicated image: the application image (Dockerfile) ships no PostgreSQL
# server/client suite. The backup job needs a pg_dump whose major version
# matches the production server (PostgreSQL 16): `pg_dump` refuses to dump from
# a NEWER server than its own major version, so this pin is what makes the job
# safe against the PostgreSQL 16 target. The version is asserted at build time.
#
# Why this base image: the previous build installed `postgresql-client-16` from
# the PGDG apt repository on `python:3.12-slim` and could not be built at all.
# Without a PostgreSQL component pin, apt also sees every other major, selects
# the newest `libpq5` (18.x), and the build dies with
#   libpq5:amd64=18.6-1.pgdg12+2 Depends libldap-2.5-0 (>= 2.5.4)
#   but none of the choices are installable
# because that dependency does not exist on bookworm. Basing the image on the
# official `postgres:16-bookworm` takes the client from Docker Hub, where it is
# rebuilt and verified for every PostgreSQL 16 patch release, and removes the
# third-party apt repository (and its key) from the build entirely. The cost is
# a larger image: this worker never runs the server, only the client tools.
#
# Build:  docker build -f Dockerfile.backup -t austro-backup:latest .
# Run:    docker compose --env-file .env up -d backup
#
# Secrets: DB_PASSWORD is supplied at run time (env/secret file), never baked
# into the image. pg_dump receives it through a 0600 .pgpass file created at
# run time - never in command arguments, never in logs.

FROM postgres:16-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# Python for the two backup scripts. The base image already puts
# /usr/lib/postgresql/16/bin (pg_dump, psql) on PATH; this only adds the
# interpreter and the driver, all from Debian bookworm's own repositories.
# The scripts are plain, version-agnostic code (3.9+ features only), so the
# distribution's Python 3.11 is sufficient; the application image remains 3.12.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies. `cryptography` is REQUIRED: scripts/pg_backup.py performs
# AES-256-GCM encryption and the restore drill decrypts. Its import is asserted
# at build time below, so an image without it cannot be produced.
COPY requirements-backup.txt /tmp/requirements-backup.txt
RUN python3 -m venv /opt/backup-venv \
    && /opt/backup-venv/bin/pip install --no-cache-dir -r /tmp/requirements-backup.txt \
    && rm -f /tmp/requirements-backup.txt

ENV PATH="/opt/backup-venv/bin:$PATH"

# The client major version is a production-safety property, so fail the build
# rather than ship an image that cannot dump the PostgreSQL 16 target.
RUN pg_dump --version | grep -Eq "pg_dump \(PostgreSQL\) 16\." \
    && python3 -c "import psycopg2; print('psycopg2', psycopg2.__version__)" \
    && python3 -c "import cryptography; from cryptography.hazmat.primitives.ciphers.aead import AESGCM; print('cryptography', cryptography.__version__, 'AESGCM OK')"

# Note: this base image declares VOLUME /var/lib/postgresql/data. The worker
# never runs the server, so that path is unused; the only data that matters is
# /app/backups, which the compose service mounts explicitly.

WORKDIR /app
COPY scripts/ ./scripts/

# Fixed UID/GID so the operator can make the encryption key file readable by
# exactly this user (and nobody else) on the host.
RUN groupadd --gid 10001 austro \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash austro \
    && mkdir -p /app/backups /var/tmp/austro-backup-work \
    && chown -R austro:austro /app /var/tmp/austro-backup-work \
    && chmod 0700 /var/tmp/austro-backup-work

USER austro

# Default: the UTC scheduler. Override for a one-shot manual backup, e.g.
#   docker compose run --rm backup python scripts/pg_backup.py /app/backups
ENTRYPOINT ["python", "scripts/backup_scheduler.py"]
