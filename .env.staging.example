# AUSTRO AI — STAGING configuration template (NON-SECRET)
#
# Copy to `.env.staging` on the staging host and fill in real values:
#   cp .env.staging.example .env.staging
#
# `.env.staging` is git-ignored (see .gitignore) and must never be committed.
# This template is the committed, secret-free contract: every value here is a
# placeholder or a staging-specific literal.
#
# RULE 1: the staging bot token must NOT be the production bot token. Create a
#         second bot with @BotFather for staging.
# RULE 2: the staging webhook URL + secret must be different from production.
# RULE 3: DB_NAME must be a dedicated, staging-marked database and DB_USER /
#         DB_PASSWORD must be staging credentials. `austro_ai` (the production
#         database name) is rejected at startup by
#         app/config/deployment_validation.py.
# RULE 4: never run scripts/pg_restore_drill.py (or any destructive restore)
#         against production. Staging restores only ever target the
#         disposable staging database.

# ============================================================================
# STAGING IDENTITY (required)
# ============================================================================
# Identifies this staging deployment; must be non-empty (startup check).
STAGING_ID=staging-1
# Image tag used for the staging build/rollback targets.
STAGING_TAG=local
# Staging logs at INFO on purpose (the only intentional difference from the
# production validation rules, which require WARNING or ERROR).
STAGING_LOG_LEVEL=INFO
# Staging webhook port is bound to 127.0.0.1 by default so a staging stack
# can never be reached from the public internet.
STAGING_WEBHOOK_BIND=127.0.0.1

# ============================================================================
# TELEGRAM (dedicated staging bot - NEVER the production token)
# ============================================================================
# From @BotFather for the SECOND bot.
BOT_TOKEN=
# Dedicated staging webhook URL (configuration only; runtime long-polls).
WEBHOOK_URL=https://staging.example.com/webhook
WEBHOOK_PORT=9443
# Dedicated staging secret, at least 16 characters, different from production.
WEBHOOK_SECRET=

# ============================================================================
# AI PROVIDER (production parity: local fallback stays DISABLED)
# ============================================================================
# A dedicated staging key is recommended so staging quota/usage is separable.
GEMINI_API_KEY=
# Local fallback is hard-coded "false" in docker-compose.staging.yml and the
# staging validator rejects it, for production parity.
USE_LOCAL_FALLBACK=false

# ============================================================================
# DEDICATED STAGING DATABASE (never the production database)
# ============================================================================
DB_HOST=staging-db.internal.example
DB_PORT=5432
# Must contain a staging marker; `austro_ai` is rejected.
DB_NAME=austro_ai_staging
DB_USER=austro_staging
DB_PASSWORD=
# REQUIRED: the host above is not loopback, so the app refuses to connect
# without TLS. libpq's own default (`prefer`) would silently fall back to
# plaintext. Use verify-full with the CA bundle in production-like setups.
DB_SSLMODE=verify-full
DB_SSL_ROOT_CERT=/etc/ssl/certs/staging-db-ca.crt
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Bounded database wait before the container gives up (fail fast, not hang).
DB_WAIT_TIMEOUT_SECONDS=120

# ============================================================================
# OPTIONAL STAGING BACKUP WORKER (profile: staging-backup)
# ============================================================================
# Only ever dumps the staging database above. Start explicitly:
#   docker compose -f docker-compose.staging.yml --env-file .env.staging \
#       --profile staging-backup up -d backup
BACKUP_SCHEDULE_UTC_HOUR=2
BACKUP_SCHEDULE_UTC_MINUTE=0
BACKUP_DAILY_KEEP=7
BACKUP_MONTHLY_KEEP=30
BACKUP_RETRY_MINUTES=60

# --- Encrypted staging backups (profile: staging-backup) -------------------
# Distinct from production: never reuse the production key file.
STAGING_BACKUP_ENCRYPTION_KEY_FILE=./secrets/staging_backup_encryption_key
BACKUP_WORKDIR_TMPFS_BYTES=4294967296
