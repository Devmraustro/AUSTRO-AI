# AUSTRO AI environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file.

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================
# Telegram bot token (required - get it from @BotFather)
BOT_TOKEN=

# ============================================================================
# OPTIONAL SETTINGS - AI PROVIDER
# ============================================================================
# Google Gemini API key (optional - falls back to local AI if unset)
GEMINI_API_KEY=
# Gemini model to use
GEMINI_MODEL=gemini-2.5-flash
# Gemini API base URL
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# Use local fallback when API unavailable
# PRODUCTION REQUIRES "0": the production validator rejects local fallback,
# so without this the app refuses to start in production.
USE_LOCAL_FALLBACK=true

# ============================================================================
# ENVIRONMENT & LOGGING
# ============================================================================
# Environment (development | testing | production)
AUSTRO_ENVIRONMENT=development
# Logging level (DEBUG | INFO | WARNING | ERROR)
# Production requires WARNING or ERROR
AUSTRO_LOG_LEVEL=INFO

# ============================================================================
# PRODUCTION WEBHOOK SETTINGS (required for production)
# ============================================================================
# Webhook URL for Telegram (e.g., https://yourdomain.com/webhook)
WEBHOOK_URL=
# Webhook port (default 8443)
WEBHOOK_PORT=8443
# Webhook secret token for verification
WEBHOOK_SECRET=

# ============================================================================
# DATABASE & STORAGE
# ============================================================================
# Database engine (sqlite | postgresql)
# PRODUCTION ARCHITECTURE: B — EXTERNALLY MANAGED PostgreSQL.
# Point DB_HOST/PORT/NAME/USER/PASSWORD at the managed PostgreSQL instance.
# The app never embeds a production database volume.
DB_ENGINE=postgresql
# PostgreSQL settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=austro_ai
DB_USER=austro
DB_PASSWORD=
# Connection pool settings (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# SQLite database file (only used when DB_ENGINE=sqlite)
DB_PATH=
# Knowledge storage directory
KNOWLEDGE_STORAGE_PATH=knowledge_storage
# Logs directory
LOGS_PATH=logs
# Backups directory
BACKUPS_PATH=backups

# ============================================================================
# APPLICATION-LEVEL RATE LIMITS (per-user, deterministic, tested)
# ============================================================================
# Per-user command limit (requests / window seconds)
RATE_LIMIT_COMMAND_MAX=30
RATE_LIMIT_COMMAND_WINDOW=60
# Per-user AI request limit
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW=60
# Per-user upload limit
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW=3600
# Per-user ingestion limit
RATE_LIMIT_INGESTION_MAX=5
RATE_LIMIT_INGESTION_WINDOW=3600
# Per-user expensive-operation limit
RATE_LIMIT_EXPENSIVE_MAX=10
RATE_LIMIT_EXPENSIVE_WINDOW=3600
# Global AI request limit
RATE_LIMIT_GLOBAL_AI_MAX=100
RATE_LIMIT_GLOBAL_AI_WINDOW=60

# ============================================================================
# AI QUOTAS & TIMEOUTS
# ============================================================================
# Maximum AI requests per day
AI_MAX_REQUESTS_PER_DAY=1500
# Minimum interval between requests (seconds)
AI_MIN_REQUEST_INTERVAL=0.5
# AI request timeout (seconds)
AI_REQUEST_TIMEOUT=30
# AI healthcheck timeout (seconds)
AI_HEALTHCHECK_TIMEOUT=15
# Maximum AI retries
AI_MAX_RETRIES=2
# Retry backoff base (seconds)
AI_RETRY_BACKOFF_BASE=0.5

# ============================================================================
# KNOWLEDGE ENGINE (RAG)
# ============================================================================
# Maximum uploaded file size (MB)
KNOWLEDGE_MAX_FILE_SIZE_MB=50
# Maximum pages per document
KNOWLEDGE_MAX_PAGES=1000
# Maximum characters per document
KNOWLEDGE_MAX_CHARS=2000000
# Maximum chunks per document
KNOWLEDGE_MAX_CHUNKS=20000
# Chunk size (characters)
KNOWLEDGE_CHUNK_SIZE=900
# Chunk overlap (characters)
KNOWLEDGE_CHUNK_OVERLAP=100
# Embedding dimensions
KNOWLEDGE_EMBEDDING_DIMENSIONS=128
# Embedding model name
KNOWLEDGE_EMBEDDING_MODEL=local-hash
# Embedding version
KNOWLEDGE_EMBEDDING_VERSION=1
# Retrieval top-k results
KNOWLEDGE_RETRIEVAL_TOP_K=8
# Minimum retrieval score (0.0-1.0)
KNOWLEDGE_RETRIEVAL_MIN_SCORE=0.20
# Context budget for RAG (characters)
KNOWLEDGE_CONTEXT_BUDGET_CHARS=6000
# Embedding batch size
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16

# ============================================================================
# PERSONAL MEMORY ENGINE
# ============================================================================
# Maximum memories to retrieve
MEMORY_MAX_RETRIEVED=12
# Memory context budget (characters)
MEMORY_CONTEXT_BUDGET_CHARS=1800
# Maximum candidate memories
MEMORY_MAX_CANDIDATES=200

# ============================================================================
# ADAPTIVE LEARNING ENGINE
# ============================================================================
# Use LLM for learning features
LEARNING_USE_LLM=false
# Maximum cached lessons
LEARNING_MAX_LESSONS_CACHE=200
# Default session duration (minutes)
LEARNING_DEFAULT_SESSION_MINUTES=25
# Review session duration (minutes)
LEARNING_REVIEW_MINUTES=5
# Maximum planner items
LEARNING_PLANNER_MAX_ITEMS=8